<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- The gripper base is mounted directly on tool0; its collision volume
       intentionally touches/overlaps the wrist housing at this fixed joint. -->
  <disable_collisions link1="gripper_base_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>
